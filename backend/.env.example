# Server
NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# Use a session-mode connection for DATABASE_URL so Prisma interactive
# transactions (order inventory) work. Transaction-mode PgBouncer (port 6543)
# can break those writes.
# If `prisma migrate deploy` fails on DIRECT_URL (port 5432 unreachable), use the
# Session pooler host for DIRECT_URL too, or run: npm run prisma:deploy:pooler
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST:6543/postgres?pgbouncer=true&sslmode=require
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres?sslmode=require

# Supabase Storage (server only)
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=replace_with_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
SUPABASE_LISTINGS_BUCKET=listings

# JWT (use different random values of at least 64 characters)
JWT_ACCESS_SECRET=replace_with_a_random_access_secret_at_least_64_characters_long_1234
JWT_REFRESH_SECRET=replace_with_a_different_refresh_secret_at_least_64_characters_123
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Encryption (64 hexadecimal characters)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Admin seed
ADMIN_SEED_EMAIL=admin@agriconnect.local
ADMIN_SEED_PASSWORD=replace_with_a_strong_password

# Optional email configuration (console fallback in local development)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@agriconnect.local

# Optional monitoring
SENTRY_DSN=

# Optional — Google AI Studio key for Kisan (farmer mascot chatbot)
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
